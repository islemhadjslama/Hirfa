# Copier ce fichier en .env.local puis renseigner les valeurs
# (Supabase > Project Settings > API Keys).

# URL du projet, ex. https://xxxx.supabase.co
VITE_SUPABASE_URL=
# Clé « publishable » (ou « anon » legacy) — utilisée par le frontend
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clé « secret » (ou « service_role » legacy) — UNIQUEMENT pour scripts/seed-demo.ts.
# Ne jamais la préfixer par VITE_ ni l'utiliser dans src/.
SUPABASE_SECRET_KEY=
